$PROBLEM    PHENOBARB SIMPLE MODEL
$INPUT      ID TIME AMT WGT APGR DV FA1 FA2
$DATA      ../../../pheno.dta IGNORE=@
            IGNORE=(ID.EQN.55,ID.EQN.56,ID.EQN.57,ID.EQN.58,ID.EQN.59)
$SUBROUTINE ADVAN1 TRANS2
$PK
TVCL=THETA(1)*WGT
TVV=THETA(2)*WGT
IF(APGR.LT.5) TVV=TVV*(1+THETA(3))
CL=TVCL*EXP(ETA(1))
V=TVV*EXP(ETA(2))
S1=V
$ERROR
W=F
Y=F+W*EPS(1)

$THETA  (0,0.00469555) ; POP_CL
$THETA  (0,0.984258) ; POP_V
$THETA  (-.99,0.15892)
$OMEGA  DIAGONAL(2)
 0.0293508  ;       IVCL
 0.027906  ;        IVV
$SIGMA  0.013241
$ESTIMATION METHOD=1 INTERACTION PRINT=1
$COVARIANCE UNCONDITIONAL
$TABLE      ID TIME AMT WGT APGR PRED CWRES NPDE NOAPPEND
            NOPRINT ONEHEADER FILE=pheno.tab
